{
  "name": "westbund-web",
  "version": "0.1.0",
  "private": true,
  "description": "ARTIFACT Futures — West Bund three-screen exhibit",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "electron:dev": "ELECTRON_START_URL=http://localhost:3000 electron .",
    "electron:start": "bun run build && electron .",
    "dist": "bun run build && electron-builder",
    "dist:mac": "bun run build && electron-builder --mac",
    "dist:win": "bun run build && electron-builder --win"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vgpu": "^0.5.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@webgpu/types": "^0.1.74",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.13",
  "trustedDependencies": [
    "electron"
  ]
}
