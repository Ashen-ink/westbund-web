{
  "name": "westbund-web",
  "version": "0.1.0",
  "private": true,
  "description": "ARTIFACT Futures — West Bund three-screen exhibit",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "next build",
    "electron": "bun run electron:dev",
    "electron:dev": "bun scripts/electron-dev.ts",
    "electron:start": "bun run build && electron .",
    "dist": "bun run build && electron-builder",
    "dist:mac": "bun run build && electron-builder --mac",
    "dist:win": "bun run build && electron-builder --win",
    "host": "bun hub/cli.cjs",
    "icons:generate": "bun scripts/generate-icons.mjs"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@central-icons-react/all": "^1.2.19",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "gsap": "^3.15.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.13",
  "trustedDependencies": [
    "electron"
  ]
}
